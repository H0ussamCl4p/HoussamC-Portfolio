# Copy to .env.local for local development. Never commit real values.
# In production, set these in Vercel > Project > Settings > Environment Variables (Production scope).

# Google service account used server-side to list /designs images from Drive.
# Provide ONE of the two. Both are read only on the server.
GOOGLE_SA_BASE64=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Drive folder ID that holds the design category folders.
DRIVE_CANVA_FOLDER_ID=
