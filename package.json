{
  "name": "houssam-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:legacy": "next dev",
    "build": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "sync-designs": "node sync-and-generate.js",
    "postinstall": "node -e \"const fs=require('fs'),p='node_modules/fast-equals/dist';if(fs.existsSync(p+'/es')&&!fs.existsSync(p+'/esm')){fs.mkdirSync(p+'/esm',{recursive:true});fs.readdirSync(p+'/es').forEach(f=>fs.copyFileSync(p+'/es/'+f,p+'/esm/'+f));}\""
  },
  "dependencies": {
    "@once-ui-system/core": "^1.4.27",
    "classnames": "^2.5.1",
    "fast-equals": "5.4.0",
    "googleapis": "^157.0.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.5.0",
    "sass": "^1.86.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.5.28",
    "typescript": "^5.8.3",
    "tzdata": "^1.0.44"
  }
}
