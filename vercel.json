{
  "version": 2,
  "builds": [
    {
      "src": "api/src/bin/mdx_parse.rs",
      "use": "@vercel/rust",
      "config": {
        "output": "api/mdx-parse"
      }
    },
    {
      "src": "api/src/bin/design_manifest.rs",
      "use": "@vercel/rust",
      "config": {
        "output": "api/design-manifest"
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/mdx-parse",
      "dest": "/api/mdx-parse"
    },
    {
      "src": "/api/design-manifest",
      "dest": "/api/design-manifest"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/wasm/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    }
  ]
}
